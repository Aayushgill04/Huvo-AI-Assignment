# ==============================================================================
# Huvo AI - Northstar Homes AI Sales Agent Configuration
# ==============================================================================

# LLM Provider: openai | groq | openrouter | gemini | mock
# Set to 'mock' if you want to test without an API key
LLM_PROVIDER=openai

# API Key for your LLM provider (Leave empty if using LLM_PROVIDER=mock)
OPENAI_API_KEY=your_openai_api_key_here

# Model identifier (e.g., gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, etc.)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom Base URL for OpenAI-compatible proxies / Groq / OpenRouter / Ollama
# For Groq: https://api.groq.com/openai/v1
# For OpenRouter: https://openrouter.ai/api/v1
# For Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Default Site Visit Failure Simulation (true / false)
SIMULATE_BOOKING_FAILURE=false
